# Environment mode (production, development)
ENVIRONMENT=development
DEBUG=True

# Application secrets
SECRET_KEY=generate_a_long_random_string_here
# This must match what you set in the Telegram bot webhook
WEBHOOK_SECRET_KEY=another_random_secret_token

# Database
SQL_HOST=db
SQL_PORT=5432
SQL_USER=postgres
SQL_PASSWORD=postgres
SQL_DB=het_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Telegram Bot API Token
TELEGRAM_BOT_TOKEN=123456789:ABCDEF...

# Monitoring
SENTRY_DSN=

# Development only - ngrok for webhook tunneling
# Get yours from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Other configurations
TIMEZONE=UTC
LOG_LEVEL=INFO
