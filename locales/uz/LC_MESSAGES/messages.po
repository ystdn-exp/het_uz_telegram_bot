#: src/bot/handlers/language.py:29
msgid ""
"🌐 <b>Select Your Language</b>\n"
"\n"
"Choose your preferred language:"
msgstr ""
"🌐 <b>Tilni tanlang</b>\n"
"\n"
"O'zingizga qulay tilni tanlang:"

#: src/bot/handlers/language.py:76
msgid ""
"🌟 <b>Welcome to HET Bot!</b> 🏠✨\n"
"\n"
"⚡️ Here you can effortlessly manage your electricity accounts and track "
"your consumption! 📉💡\n"
"\n"
"🚀 Let's get started! Use the menu below to navigate. 👇"
msgstr ""
"🌟 <b>HET Botga xush kelibsiz!</b> 🏠✨\n"
"\n"
"⚡️ Bu yerda siz elektr energiyasi hisoblaringizni oson boshqarishingiz va"
" iste'molni kuzatib borishingiz mumkin! 📉💡\n"
"\n"
"🚀 Qani boshladik! Navigatsiya uchun quyidagi menyudan foydalaning. 👇"

#: src/bot/handlers/register.py:42
msgid ""
"🚫 <b>Limit Reached</b>\n"
"\n"
"You have reached the maximum limit of 3 linked accounts.\n"
"To add a new one, please remove an existing account first."
msgstr ""
"🚫 <b>Limitga yetildi</b>\n"
"\n"
"Siz 3 ta hisobni ulash limitiga yetdingiz.\n"
"Yangi hisob qo'shish uchun, iltimos, mavjud hisoblardan birini o'chiring."

#: src/bot/handlers/register.py:53
msgid ""
"👤 <b>Username Required</b>\n"
"\n"
"Please enter your HET account username:"
msgstr ""
"👤 <b>Login talab qilinadi</b>\n"
"\n"
"Iltimos, HET hisobingiz loginini kiriting:"

#: src/bot/handlers/register.py:73
msgid ""
"⚠️ <b>Invalid Username</b>\n"
"\n"
"Username cannot be empty. Please try again:"
msgstr ""
"⚠️ <b>Noto'g'ri login</b>\n"
"\n"
"Login bo'sh bo'lishi mumkin emas. Iltimos, qaytadan urunib ko'ring:"

#: src/bot/handlers/register.py:85
msgid ""
"🔐 <b>Password Required</b>\n"
"\n"
"Great! Now please enter your HET account password:"
msgstr ""
"🔐 <b>Parol talab qilinadi</b>\n"
"\n"
"Ajoyib! Endi HET hisobingiz parolini kiriting:"

#: src/bot/handlers/register.py:105
msgid ""
"⚠️ <b>Invalid Password</b>\n"
"\n"
"Password cannot be empty. Please try again:"
msgstr ""
"⚠️ <b>Noto'g'ri parol</b>\n"
"\n"
"Parol bo'sh bo'lishi mumkin emas. Iltimos, qaytadan urunib ko'ring:"

#: src/bot/handlers/register.py:122
msgid ""
"🔄 <b>Verifying Credentials...</b>\n"
"Please wait while we check your details."
msgstr ""
"🔄 <b>Ma'lumotlar tekshirilmoqda...</b>\n"
"Iltimos, ma'lumotlaringiz tekshirilguncha kuting."

#: src/bot/handlers/register.py:144
msgid ""
"🎉 <b>Success!</b>\n"
"\n"
"Account has been successfully linked!\n"
"You can now track your electricity consumption statistics effortlessly 📉"
msgstr ""
"🎉 <b>Muvaffaqiyatli!</b>\n"
"\n"
"Hisob muvaffaqiyatli ulandi!\n"
"Endi siz elektr energiyasi iste'moli statistikasini osongina kuzatib "
"borishingiz mumkin 📉"

#: src/bot/handlers/register.py:162
#, python-brace-format
msgid ""
"❌ <b>Authentication Failed</b>\n"
"\n"
"{error}\n"
"\n"
"Please check your credentials and try again."
msgstr ""
"❌ <b>Avtentifikatsiya xatosi</b>\n"
"\n"
"{error}\n"
"\n"
"Iltimos, ma'lumotlaringizni tekshiring va qaytadan urunib ko'ring."

#: src/bot/handlers/register.py:184
msgid "❌ An unexpected error occurred. Please try again later."
msgstr "❌ Kutilmagan xato yuz berdi. Iltimos, keyinroq qaytadan urunib ko'ring."

#: src/bot/handlers/start.py:30
msgid ""
"Please select your language / Пожалуйста, выберите язык / Iltimos, tilni "
"tanlang:"
msgstr ""
"Iltimos, tilni tanlang / Пожалуйста, выберите язык / Please select your "
"language:"

#: src/bot/handlers/users.py:60
msgid ""
"📭 <b>No Accounts Linked</b>\n"
"\n"
"You haven't linked any HET accounts yet.\n"
"Tap <b>'➕ Add Account'</b> below to get started and track your usage!"
msgstr ""
"📭 <b>Hisoblar ulanmagan</b>\n"
"\n"
"Siz hali biron bir HET hisobini ulamadingiz.\n"
"Iste'molni kuzatishni boshlash uchun quyidagi <b>'➕ Hisob qo'shish'</b> "
"tugmasini bosing!"

#: src/bot/handlers/users.py:76 src/bot/handlers/users.py:778
#: src/bot/handlers/users.py:785
msgid ""
"📋 <b>Your HET Accounts</b>\n"
"\n"
"Select an account below to view detailed statistics and consumption data:"
msgstr ""
"📋 <b>Sizning HET hisoblaringiz</b>\n"
"\n"
"Statistika va iste'mol ma'lumotlarini ko'rish uchun quyidagi hisoblardan "
"birini tanlang:"

#: src/bot/handlers/users.py:94
msgid ""
"🤖 <b>HET Bot Assistance</b>\n"
"\n"
"Here's how I can help you manage your electricity data:\n"
"\n"
"<b>📂 Account Management</b>\n"
"• <b>➕ Add Account:</b> Link up to 3 HET electricity accounts.\n"
"• <b>👁 My Accounts:</b> View linked accounts, check balances & "
"statistics.\n"
"\n"
"<b>📊 Statistics & Tracking</b>\n"
"View detailed consumption graphs for:\n"
"• 🗓 Monthly\n"
"• 📅 Yearly\n"
"\n"
"• 📑 Meter Readings & Payments History\n"
"\n"
"<b>🔔 Notifications</b>\n"
"I'll send you a daily summary of your electricity usage at 10:00 AM.\n"
"\n"
"<b>🆘 Support</b>\n"
"Need more help? Contact your system administrator."
msgstr ""
"🤖 <b>HET Bot yordami</b>\n"
"\n"
"Men sizga elektr energiyasi ma'lumotlarini boshqarishda quyidagicha "
"yordam bera olaman:\n"
"\n"
"<b>📂 Hisoblarni boshqarish</b>\n"
"• <b>➕ Hisob qo'shish:</b> 3 tagacha HET elektr hisoblarini ulang.\n"
"• <b>👁 Mening hisoblarim:</b> Ulangan hisoblar, balans va statistikani "
"ko'ring.\n"
"\n"
"<b>📊 Statistika va kuzatish</b>\n"
"Iste'mol grafiklarini ko'rish:\n"
"• 🗓 Oylik\n"
"• 📅 Yillik\n"
"\n"
"• 📑 Hisoblagich ko'rsatkichlari va to'lovlar tarixi\n"
"\n"
"<b>🔔 Bildirishnomalar</b>\n"
"Men sizga har kuni soat 10:00 da iste'mol bo'yicha hisobot yuboraman.\n"
"\n"
"<b>🆘 Qo'llab-quvvatlash</b>\n"
"Yordam kerakmi? Tizim administratoriga murojaat qiling."

