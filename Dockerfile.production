FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Standard build tools (only if some packages still need compilation)
    gcc \
    libc6-dev \
    # PostgreSQL headers for asyncpg/psycopg2
    libpq-dev \
    # Common libraries for cryptography and security
    libffi-dev \
    libssl-dev \
    netcat-openbsd \
    # Utility tools
    cron \
    curl \
    && pip install --upgrade pip setuptools wheel \
    # Clean up to keep the image small
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /home/user/bot

# Best practice: Copy only requirements first to leverage Docker cache
COPY requirements/ ./requirements/
RUN pip install --no-cache-dir -r requirements/development.txt

COPY . .

# Ensure the entrypoint is executable
RUN chmod +x docker-entrypoint.sh

ENTRYPOINT ["./docker-entrypoint.sh"]
